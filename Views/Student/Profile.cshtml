@model UniversityTournamentPro.Models.ApplicationUser

@{
    ViewData["Title"] = "Profil Bilgilerim";
}

@* --- ÜST BANNER (Diğer sayfalarla uyumlu) --- *@
<div class="row mb-4">
    <div class="col-12 text-center py-5 text-white shadow-sm" style="background-color: #262F59; border-radius: 0 0 20px 20px;">
        <div class="rounded-circle bg-white text-primary d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: bold; color: #262F59 !important;">
            @Model.FirstName.Substring(0, 1).ToUpper()
        </div>
        <h1 class="fw-bold">@Model.FirstName @Model.LastName</h1>
        <p class="opacity-75">Öğrenci Profil Bilgileri ve Hesap Ayarları</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4" style="color: #262F59;"><i class="bi bi-person-lines-fill me-2"></i>Kişisel Bilgiler</h5>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-left: 5px solid #198754 !important;">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">E-Posta Adresi</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-envelope-at text-muted"></i></span>
                                    <input type="text" class="form-control bg-light border-0" value="@Model.Email" readonly disabled />
                                </div>
                                <small class="text-muted ms-1">E-posta adresi güvenliğiniz için değiştirilemez.</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Adınız</label>
                                <input asp-for="FirstName" class="form-control shadow-sm" placeholder="Adınız" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Soyadınız</label>
                                <input asp-for="LastName" class="form-control shadow-sm" placeholder="Soyadınız" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Telefon Numaranız</label>
                                <input asp-for="PhoneNumber" class="form-control shadow-sm" placeholder="05XX XXX XX XX" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Fakülte / Bölüm</label>
                                <input asp-for="Faculty" class="form-control shadow-sm" placeholder="Bölümünüzü giriniz" />
                            </div>
                        </div>

                        <hr class="my-4 opacity-25">

                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            @* --- ŞİFRE DEĞİŞTİRME BUTONU (YENİ) --- *@
                            <a asp-action="ChangePassword" class="btn btn-outline-warning rounded-pill px-4 fw-bold">
                                <i class="bi bi-shield-lock-fill me-2"></i>Şifre Değiştir
                            </a>

                            <button type="submit" class="btn text-white px-5 rounded-pill fw-bold shadow" style="background-color: #262F59;">
                                <i class="bi bi-save2 me-2"></i>DEĞİŞİKLİKLERİ KAYDET
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #262F59;
        box-shadow: 0 0 0 0.25rem rgba(38, 47, 89, 0.1);
    }
</style>