@model IEnumerable<UniversityTournamentPro.Models.TournamentSelection>

@{
    ViewData["Title"] = "Başvurularım";
}

<div class="container mt-5">
    @* --- İşlem Mesajları --- *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #262F59;">
            <i class="bi bi-journal-check me-2"></i>Başvuru Takip Paneli
        </h2>
        <a asp-action="Index" class="btn btn-outline-primary shadow-sm" style="border-radius: 20px; font-weight: 600;">
            <i class="bi bi-plus-circle me-2"></i>Yeni Turnuva Bul
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm bg-white" style="border-radius: 15px; border: 2px dashed #dee2e6;">
            <i class="bi bi-clipboard-x fs-1 text-muted"></i>
            <p class="mt-3 fs-5 text-muted">Henüz herhangi bir turnuvaya başvurmadınız.</p>
            <a asp-action="Index" class="btn btn-primary mt-2">Hemen Başvur</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 15px; transition: transform 0.2s;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-3">
                                    @{
                                        var iconClass = item.Status == "Onaylandı" ? "bi-check-circle-fill text-success" :
                                        item.Status == "Reddedildi" ? "bi-x-circle-fill text-danger" :
                                        "bi-hourglass-split text-warning";
                                        var bgClass = item.Status == "Onaylandı" ? "bg-success-subtle" :
                                        item.Status == "Reddedildi" ? "bg-danger-subtle" :
                                        "bg-warning-subtle";
                                    }
                                    <div class="rounded-circle p-3 @bgClass">
                                        <i class="bi @iconClass fs-3"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="fw-bold mb-1 text-dark">@item.Tournament?.Name</h5>
                                        <small class="text-muted">@item.SelectionDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <p class="text-secondary mb-2">Branş: @item.Tournament?.Branch | Takım: <strong>@item.TeamName</strong></p>

                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="badge @(item.Status == "Onaylandı" ? "bg-success" : item.Status == "Reddedildi" ? "bg-danger" : "bg-warning text-dark") p-2 px-3" style="border-radius: 10px;">
                                                @item.Status
                                            </span>
                                        </div>

                                        @* 🔥 DÜZELTİLDİ: name="id" yaparak Controller ile eşleştirdik *@
                                        @if (item.Status == "Onay Bekliyor")
                                        {
                                            <form asp-action="CancelApplication" method="post" onsubmit="return confirm('Bu başvuruyu iptal etmek istediğinize emin misiniz?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none fw-bold">
                                                    <i class="bi bi-trash3 me-1"></i>Vazgeç
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
    }

    .bg-success-subtle {
        background-color: #d1e7dd;
    }

    .bg-danger-subtle {
        background-color: #f8d7da;
    }

    .bg-warning-subtle {
        background-color: #fff3cd;
    }
</style>