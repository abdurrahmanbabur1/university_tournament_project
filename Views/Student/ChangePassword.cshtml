@model UniversityTournamentPro.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="row mb-4">
    <div class="col-12 text-center py-5 text-white shadow-sm" style="background-color: #262F59; border-radius: 0 0 20px 20px;">
        <h1 class="fw-bold"><i class="bi bi-shield-lock me-2"></i>Şifre Güncelleme</h1>
        <p class="opacity-75">Hesap güvenliğiniz için düzenli şifre değiştirmenizi öneririz.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mevcut Şifre</label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Şu anki şifreniz" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Yeni Şifre</label>
                            <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Yeni Şifre (Tekrar)</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni şifreyi tekrar yazın" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn text-white py-2 fw-bold rounded-pill" style="background-color: #262F59;">
                                ŞİFREYİ GÜNCELLE
                            </button>
                            <a asp-action="Profile" class="btn btn-light rounded-pill">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>