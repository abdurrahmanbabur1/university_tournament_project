@model IEnumerable<UniversityTournamentPro.Models.Tournament>

@{
    ViewData["Title"] = "Turnuva Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: var(--u-mavi);">
            <i class="bi bi-trophy-fill me-2"></i>Aktif Turnuvalar
        </h2>

        <div>
            <a asp-action="ManageTeams" class="btn btn-outline-primary px-4 me-2 shadow-sm" style="border-radius: 20px; font-weight: 600;">
                <i class="bi bi-people-fill me-2"></i>Başvuruları Yönet
            </a>

            <a asp-action="CreateTournament" class="btn text-white px-4 shadow-sm" style="background-color: var(--u-turkuaz); border-radius: 20px; font-weight: 600;">
                <i class="bi bi-plus-circle me-2"></i>Yeni Turnuva Oluştur
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Turnuva Adı</th>
                        <th>Branş</th>
                        <th>Başlangıç Tarihi</th>
                        <th>Turnuva Yeri</th>
                        <th>Kategori</th>
                        <th>Durum</th>

                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle d-block fs-2 mb-2"></i>
                                Henüz hiç turnuva eklenmemiş.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold" style="color: var(--u-mavi);">@item.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Branch</span>
                            </td>
                            <td>@item.StartDate.ToShortDateString()</td>
                            <td>@item.Location</td>
                            <td>
                                @if (item.GenderCategory == "Erkek") { <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2">👨 Erkek</span> }
                                else if (item.GenderCategory == "Kadın") { <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2">👩 Kadın</span> }
                                else { <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2">🌍 Karma</span> }
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")" style="border-radius: 5px;">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="EditTournament" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="DeleteTournament" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu turnuvayı silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table thead th {
        border-top: none;
        padding: 15px;
        font-weight: 600;
        color: #555;
    }

    .table tbody td {
        padding: 15px;
    }
</style>