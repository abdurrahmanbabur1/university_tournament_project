@model UniversityTournamentPro.Models.Match

@{
    ViewData["Title"] = "Yeni Maç Oluştur";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 20px;">
                <div class="card-header text-white" style="background-color: var(--u-mavi); border-radius: 20px 20px 0 0;">
                    <h4 class="mb-0 py-2"><i class="bi bi-calendar-plus me-2"></i>Yeni Maç Planla</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateMatch" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Bağlı Olduğu Turnuva</label>
                            <select asp-for="TournamentId" class="form-select" style="border-radius: 10px;" required>
                                <option value="">Turnuva Seçiniz...</option>
                                @foreach (var t in ViewBag.Tournaments)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Maç Başlığı</label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Mühendislik vs İİBF (Yarı Final)" style="border-radius: 10px;" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Branch" class="form-label fw-bold">Spor Branşı</label>
                                <select asp-for="Branch" class="form-select" style="border-radius: 10px;">
                                    <option value="Futbol">⚽ Futbol</option>
                                    <option value="Basketbol">🏀 Basketbol</option>
                                    <option value="Voleybol">🏐 Voleybol</option>
                                    <option value="Satranç">♟️ Satranç</option>
                                    <option value="Tenis">🎾 Tenis</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MatchDate" class="form-label fw-bold">Maç Tarihi ve Saati</label>
                                <input asp-for="MatchDate" type="datetime-local" class="form-control" style="border-radius: 10px;" />
                                <span asp-validation-for="MatchDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-bold">Maç Yeri / Saha</label>
                            <input asp-for="Location" class="form-control" placeholder="Örn: Kapalı Spor Salonu - Saha A" style="border-radius: 10px;" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Ek Notlar</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Hakem bilgisi veya özel notlar..." style="border-radius: 10px;"></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Matches" class="btn btn-outline-secondary px-4 me-md-2" style="border-radius: 10px;">İptal</a>
                            <button type="submit" class="btn text-white px-5" style="background-color: var(--u-turkuaz); border-radius: 10px; font-weight: 600;">
                                Maçı Kaydet ve Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>