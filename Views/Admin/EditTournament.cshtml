@model UniversityTournamentPro.Models.Tournament

@{
    ViewData["Title"] = "Turnuva Düzenle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 pt-4 ps-4">
                    <h3 class="fw-bold" style="color: var(--u-mavi);"><i class="bi bi-pencil-square me-2"></i>Turnuva Düzenle</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditTournament" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Turnuva Adı</label>
                            <input asp-for="Name" class="form-control" style="border-radius: 10px;" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Branş</label>
                                <input asp-for="Branch" class="form-control" style="border-radius: 10px;" required />
                                <span asp-validation-for="Branch" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Başlangıç Tarihi</label>
                                <input asp-for="StartDate" type="date" class="form-control" style="border-radius: 10px;" required />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            @* 🔥 YENİ: KONTENJAN GÜNCELLEME ALANI *@
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Kontenjan</label>
                                <input asp-for="Quota" type="number" class="form-control" style="border-radius: 10px;" min="1" required />
                                <span asp-validation-for="Quota" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" style="border-radius: 10px;"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Turnuva Yeri</label>
                            <input asp-for="Location" class="form-control" style="border-radius: 10px;" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox">
                            <label class="form-check-label fw-bold">Turnuva Aktif mi?</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px; background-color: var(--u-mavi); border: none;">Güncelle</button>
                            <a asp-action="Tournaments" class="btn btn-outline-secondary px-4" style="border-radius: 10px;">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}