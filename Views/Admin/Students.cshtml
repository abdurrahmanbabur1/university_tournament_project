@model IEnumerable<UniversityTournamentPro.Models.ApplicationUser>

@{
    ViewData["Title"] = "Öğrenci Yönetimi";
}

<div class="container mt-4 mb-5">
    @* --- ÜST BAŞLIK VE ÖZET --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0" style="color: var(--u-mavi);">
                <i class="bi bi-people-fill me-2"></i>Kayıtlı Öğrenciler
            </h2>
            <p class="text-muted small mb-0">Sistemdeki tüm öğrenci hesaplarını buradan yönetebilirsiniz.</p>
        </div>
        <span class="badge bg-primary px-4 py-2 shadow-sm" style="border-radius: 12px; font-size: 0.9rem;">
            Toplam: @Model.Count() Öğrenci
        </span>
    </div>

    @* --- TABLO KARTI --- *@
    <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Öğrenci Bilgileri</th>
                            <th class="py-3 text-center">İletişim & Tel</th>
                            <th class="py-3 text-center">Kayıt Tarihi</th>
                            <th class="py-3 text-center">Durum</th>
                            <th class="text-center py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-exclamation fs-1 d-block mb-2"></i>
                                    Henüz kayıtlı bir öğrenci bulunmuyor.
                                </td>
                            </tr>
                        }
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px; font-weight: 700; font-size: 1.2rem;">
                                            @user.FirstName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.FirstName @user.LastName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">NO: @user.StudentNo</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="fw-medium">@user.Email</div>
                                    <div class="text-success small fw-bold mt-1">
                                        <i class="bi bi-telephone-fill me-1"></i> @(string.IsNullOrEmpty(user.PhoneNumber) ? "Belirtilmemiş" : user.PhoneNumber)
                                    </div>
                                </td>
                                <td class="text-center text-muted small">
                                    @user.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="text-center">
                                    @if (user.IsApproved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Aktif / Onaylı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">
                                            <i class="bi bi-clock-history me-1"></i> Onay Bekliyor
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        @* --- ONAYLA BUTONU (Sadece Onay Bekleyenler İçin) --- *@
                                        @if (!user.IsApproved)
                                        {
                                            <form asp-action="ApproveStudent" asp-route-id="@user.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success rounded-3 px-3 shadow-sm" title="Onayla">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }

                                        @* --- MESAJ GÖNDER --- *@
                                        <a href="mailto:@user.Email" class="btn btn-sm btn-outline-info rounded-3 shadow-sm" title="Mail Gönder">
                                            <i class="bi bi-envelope"></i>
                                        </a>

                                        @* --- SİLME BUTONU (Form İçinde) --- *@
                                        <form asp-action="DeleteStudent" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('BU ÖĞRENCİYİ VE TÜM BAŞVURULARINI SİLMEK İSTEDİĞİNİZE EMİN MİSİNİZ?\n\nBu işlem geri alınamaz!');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 shadow-sm" title="Tamamen Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* --- ALT NAVİGASYON --- *@
    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Dashboard'a Dön
        </a>
    </div>
</div>

@* --- TABLO ÖZEL STİLLERİ --- *@
<style>
    .bg-success-subtle {
        background-color: #e1f5ea !important;
    }

    .bg-warning-subtle {
        background-color: #fff9e6 !important;
    }

    .table thead th {
        border-top: none;
        font-weight: 600;
        font-size: 0.85rem;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table tbody tr {
        transition: all 0.25s ease;
        border-bottom: 1px solid #f1f1f1;
    }

        .table tbody tr:hover {
            background-color: #fcfdfe !important;
            transform: scale(1.002);
            box-shadow: inset 4px 0 0 var(--u-mavi);
        }

    .btn-sm {
        padding: 0.4rem 0.6rem;
    }

    .rounded-3 {
        border-radius: 10px !important;
    }
</style>