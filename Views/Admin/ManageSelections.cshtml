@model IEnumerable<UniversityTournamentPro.Models.TournamentSelection>

<div class="container mt-4">
    <h2 class="fw-bold mb-4" style="color: #1a237e;">Başvuruları Yönet</h2>

    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Öğrenci Bilgileri</th>
                    <th>Turnuva</th>
                    <th>Takım Adı</th>
                    <th>Başvuru Tarihi</th>
                    <th>Durum</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            @* Hata almamak için güvenli erişim kullanıyoruz *@
                            <div class="fw-bold">@item.Student?.Email</div>
                            <small class="text-muted">ID: @item.Student?.Id</small>
                        </td>
                        <td>@item.Tournament?.Name</td>
                        <td>@(string.IsNullOrEmpty(item.TeamName) ? "Bireysel" : item.TeamName)</td>
                        <td>@item.SelectionDate.ToShortDateString()</td>
                        <td>
                            @{
                                var statusClass = item.Status == "Onaylandı" ? "bg-success" :
                                item.Status == "Reddedildi" ? "bg-danger" : "bg-warning text-dark";
                            }
                            <span class="badge @statusClass">@item.Status</span>
                        </td>
                        <td class="text-center">
                            @if (item.Status == "Onay Bekliyor")
                            {
                                <form asp-action="UpdateSelectionStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Onaylandı" />
                                    <button type="submit" class="btn btn-sm btn-success shadow-sm">Onayla</button>
                                </form>

                                <form asp-action="UpdateSelectionStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Reddedildi" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1 shadow-sm">Reddet</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Karar Verildi</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>