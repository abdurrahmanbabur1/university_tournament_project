@model UniversityTournamentPro.Models.HomeViewModel

@{
    ViewData["Title"] = "MTÜ Turnuva Platformu";
}

@* --- 1. DUYURULAR SLIDER --- *@
<div id="mainSlider" class="carousel slide carousel-fade shadow-lg mb-5" data-bs-ride="carousel" style="border-radius: 20px; overflow: hidden;">
    @* Carousel Göstergeleri *@
    <div class="carousel-indicators">
        @if (Model.Announcements != null && Model.Announcements.Any())
        {
            for (int i = 0; i < Model.Announcements.Count(); i++)
            {
                <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
            }
        }
        else
        {
            <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        }
    </div>

    <div class="carousel-inner">
        @if (Model.Announcements == null || !Model.Announcements.Any())
        {
            <div class="carousel-item active" style="height: 500px;">
                <img src="/images/default-announcement.jpg" class="d-block w-100 h-100" alt="Hoşgeldiniz" style="object-fit: cover; object-position: center; filter: brightness(0.6);">
                <div class="carousel-caption d-none d-md-block text-center shadow-none bg-transparent">
                    <h1 class="display-3 fw-bold text-white mb-3">MTÜ TURNUVA PORTALI</h1>
                    <p class="lead text-white-50">Üniversitemizin en heyecanlı spor etkinlikleri burada!</p>
                </div>
            </div>
        }
        else
        {
            var isFirst = true;
            foreach (var item in Model.Announcements)
            {
                var imgUrl = string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-announcement.jpg" : item.ImageUrl;
                <div class="carousel-item @(isFirst ? "active" : "")" data-bs-interval="5000" style="height: 500px; position: relative; overflow: hidden;">
                    <!-- Bulanık Arka Plan Katmanı -->
                    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
                                background-image: url('@imgUrl'); 
                                background-size: cover; background-position: center; 
                                filter: blur(25px) brightness(0.5); transform: scale(1.1); z-index: 1;">
                    </div>

                    <!-- Ana Resim (Sığdırılmış ve Net) -->
                    <img src="@imgUrl" class="d-block mx-auto h-100" alt="@item.Title" 
                         style="position: relative; z-index: 2; object-fit: contain; max-width: 100%;">
                    
                    @* --- KÖŞEYE KÜÇÜK BUTON --- *@
                    @if (item.TournamentId.HasValue)
                    {
                        <div style="position: absolute; bottom: 30px; right: 30px; z-index: 100;">
                            <a href="/Home/Details/@item.TournamentId" 
                               class="btn text-white shadow-lg fw-bold px-4 py-2 slider-detail-btn" 
                               style="background-color: var(--u-mavi); border-radius: 50px; border: 2px solid rgba(255,255,255,0.5); font-size: 0.9rem; transition: all 0.3s ease;">
                                <i class="bi bi-arrow-right-circle-fill me-2"></i> Turnuva Detayları
                            </a>
                        </div>
                    }

                    @* --- BAŞLIK ROZETİ --- *@
                    <div style="position: absolute; top: 20px; left: 20px; z-index: 100;">
                         <span class="badge bg-dark bg-opacity-50 blur-3 px-3 py-2 text-white" style="border-radius: 10px; font-size: 0.9rem;">
                             @item.Title
                         </span>
                    </div>
                </div>
                isFirst = false;
            }

        }
    </div>

    @* Carousel Kontrolleri *@
    <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
        <span class="visually-hidden">Geri</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
        <span class="visually-hidden">İleri</span>
    </button>
</div>

@* --- 2. DURUM PANELLERİ --- *@
<div class="container" style="position: relative; z-index: 10; margin-top: 40px;">
    <div class="row justify-content-center g-4">
        <div class="col-md-11">
            <div class="card shadow-lg border-0 p-4 rounded-4 bg-white" style="border-left: 10px solid var(--u-mavi) !important; border-top: 1px solid #eee;">
                <div class="row align-items-center">
                    <div class="col-md">
                        <h2 class="fw-bold mb-1" style="color: var(--u-mavi);"><i class="bi bi-stars text-warning me-2"></i>Hoş Geldiniz!</h2>
                        <p class="text-muted mb-0">Aktif turnuvaları ve maç takvimini aşağıdan inceleyebilirsiniz.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- 3. TAKVİM VE BRANŞLAR --- *@
<div class="container mt-5 py-5">
    <div class="row g-5">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h4 class="fw-bold mb-4" style="color: var(--u-mavi);"><i class="bi bi-calendar-check-fill me-3 text-primary"></i>Müsabaka Takvimi</h4>
                <div id="calendar"></div>
            </div>
        </div>
        <div class="col-lg-5">
            <h4 class="fw-bold mb-4" style="color: var(--u-mavi);"><i class="bi bi-trophy-fill me-3 text-warning"></i>Aktif Branşlar</h4>
            <div class="row g-3">
                @if (Model.Branches != null && Model.Branches.Any())
                {
                    foreach (var br in Model.Branches)
                    {
                        <div class="col-12">
                            <a asp-action="BranchTournaments" asp-route-branchName="@br.Name" class="text-decoration-none">
                                <div class="p-4 rounded-4 shadow-sm text-white brans-card" style="background: linear-gradient(45deg, #262F59, #3f51b5);">
                                    <h5 class="m-0 fw-bold"><span class="fs-4 me-3">@br.Emoji</span> @br.Name <i class="bi bi-chevron-right float-end"></i></h5>
                                </div>
                            </a>
                        </div>

                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Turnuva Detay Modalı -->
<div class="modal fade" id="tournamentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 bg-primary text-white p-4 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Turnuva Bilgileri</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold mb-1">Turnuva Adı</label>
                    <h4 id="mt-name" class="fw-bold" style="color: var(--u-mavi);"></h4>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="small text-muted text-uppercase fw-bold mb-1">Branş</label>
                        <div id="mt-branch" class="fw-bold text-dark"></div>
                    </div>
                    <div class="col-6">
                        <label class="small text-muted text-uppercase fw-bold mb-1">Tarih</label>
                        <div id="mt-date" class="fw-bold text-dark"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold mb-1">Yer / Konum</label>
                    <div id="mt-location" class="fw-bold text-primary"></div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold mb-1">Açıklama</label>
                    <p id="mt-description" class="text-muted"></p>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                    <span class="fw-bold text-dark">Kontenjan:</span>
                    <span id="mt-quota" class="badge bg-primary fs-6 rounded-pill"></span>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <a id="mt-details-link" href="#" class="btn btn-primary rounded-pill px-4 fw-bold">Detaylara Git</a>
            </div>
        </div>
    </div>
</div>

<style>
    .brans-card { transition: all 0.3s ease; cursor: pointer; }
    .brans-card:hover { transform: translateX(10px); filter: brightness(1.1); }
    #calendar { border: none !important; }
    .fc-header-toolbar { margin-bottom: 1.5rem !important; }
    .blur-3 { backdrop-filter: blur(3px); }
    .slider-detail-btn:hover { background-color: var(--u-turuncu) !important; transform: scale(1.05); color: white !important; }
</style>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                headerToolbar: { left: 'prev', center: 'title', right: 'next' },
                themeSystem: 'bootstrap5',
                events: [
                    @foreach (var m in (Model.Matches ?? new List<Match>())) {
                        var emoji = Model.Branches?.FirstOrDefault(b => string.Equals(b.Name?.Trim(), m.Branch?.Trim(), StringComparison.OrdinalIgnoreCase))?.Emoji ?? "📅";
                        var tName = (m.Tournament?.Name ?? m.Title ?? "Maç").Replace("'", "\\'");
                        var mTitle = (m.Title ?? "Bilinmeyen Maç").Replace("'", "\\'");
                        var tDesc = (m.Tournament?.Description ?? "").Replace("'", "\\'").Replace("\r", "").Replace("\n", " ");
                        <text>
                        {
                            title: '@Html.Raw(emoji) @mTitle',
                            start: '@m.MatchDate.ToString("yyyy-MM-ddTHH:mm:ss")',
                            backgroundColor: '#262F59',
                            borderColor: '#262F59',
                            extendedProps: {
                                tournamentId: '@m.TournamentId',
                                tournamentName: '@tName',
                                branch: '@(m.Branch?.Replace("'", "\\'"))',
                                dateStr: '@m.MatchDate.ToString("dd.MM.yyyy HH:mm")',
                                description: '@tDesc',
                                quota: '@(m.Tournament?.Quota ?? 0)',
                                location: '@(m.Location ?? m.Tournament?.Location ?? "Bilinmiyor")'
                            }
                        },
                        </text>
                    }
                    @foreach (var t in (Model.Tournaments ?? new List<Tournament>())) {
                        var emoji = Model.Branches?.FirstOrDefault(b => string.Equals(b.Name?.Trim(), t.Branch?.Trim(), StringComparison.OrdinalIgnoreCase))?.Emoji ?? "🏆";
                        var tName = (t.Name ?? "Turnuva").Replace("'", "\\'");
                        var tDesc = (t.Description ?? "").Replace("'", "\\'").Replace("\r", "").Replace("\n", " ");
                        <text>
                        {
                            title: '@Html.Raw(emoji) @tName',
                            start: '@t.StartDate.ToString("yyyy-MM-dd")',
                            backgroundColor: '#ffc107',
                            borderColor: '#ffc107',
                            textColor: '#000',
                            extendedProps: {
                                tournamentId: '@t.Id',
                                tournamentName: '@tName',
                                branch: '@(t.Branch?.Replace("'", "\\'"))',
                                dateStr: '@t.StartDate.ToString("dd.MM.yyyy")',
                                description: '@tDesc',
                                quota: '@t.Quota',
                                location: '@(t.Location ?? "Bilinmiyor")'
                            }
                        },
                        </text>
                    }
                ],
                eventClick: function(info) {
                    var props = info.event.extendedProps;
                    document.getElementById('mt-name').innerHTML = props.tournamentName;
                    document.getElementById('mt-branch').innerText = props.branch;
                    document.getElementById('mt-date').innerText = props.dateStr;
                    document.getElementById('mt-description').innerHTML = props.description;
                    document.getElementById('mt-quota').innerText = props.quota;
                    document.getElementById('mt-location').innerText = props.location;
                    document.getElementById('mt-details-link').href = '/Home/Details/' + props.tournamentId;
                    new bootstrap.Modal(document.getElementById('tournamentModal')).show();
                }
            });
            calendar.render();
        });
    </script>
}