using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using UniversityTournamentPro.Data;
using UniversityTournamentPro.Models;

namespace UniversityTournamentPro.Controllers
{
    public class HomeController : Controller
    {
        private readonly ApplicationDbContext _context;

        public HomeController(ApplicationDbContext context)
        {
            _context = context;
        }

        // --- ANA SAYFA: Ma�lar, Duyurular ve Admin Uyar� Say�s� ---
        public async Task<IActionResult> Index()
        {
            var viewModel = new HomeViewModel
            {
                // Yakla�an son 5 ma�� �ekiyoruz
                Matches = await _context.Matches
                    .Include(m => m.Tournament)
                    .OrderByDescending(m => m.MatchDate)
                    .Take(5)
                    .ToListAsync(),

                // --- G�NCELLEME: Duyurular� ba�l� olduklar� turnuva bilgisiyle �ekiyoruz ---
                Announcements = await _context.Announcements
                    .Include(a => a.Tournament) // Duyuru-Turnuva k�pr�s�n� burada kuruyoruz
                    .Where(a => a.IsActive)
                    .OrderByDescending(a => a.CreatedDate)
                    .Take(5)
                    .ToListAsync(),

                PendingUserCount = await _context.Users.CountAsync(u => !u.IsApproved)
            };

            return View(viewModel);
        }

        // --- TURNUVA DETAYLARI ---
        // ��renci duyuruya t�klad���nda o duyurunun 'TournamentId'si buraya gelir
        public async Task<IActionResult> Details(int? id)
        {
            // E�er ID gelmemi�se veya yanl�� gelmi�se ana sayfaya geri yolla
            if (id == null)
            {
                return RedirectToAction(nameof(Index));
            }

            // Veritaban�nda o spesifik turnuvay� buluyoruz
            var tournament = await _context.Tournaments
                .FirstOrDefaultAsync(t => t.Id == id);

            // E�er veritaban�nda b�yle bir turnuva kalmam��sa (silinmi�se) 404 ver
            if (tournament == null)
            {
                return NotFound();
            }

            // Buldu�umuz turnuvay� Details.cshtml sayfas�na "Model" olarak g�nderiyoruz
            return View(tournament);
        }

        public IActionResult Privacy()
        {
            return View();
        }
    }
}
