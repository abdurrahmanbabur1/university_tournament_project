@page
@{
    ViewData["Title"] = "E-posta Gönderildi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 text-center" style="border-radius: 20px; overflow: hidden;">
                <div class="p-4 text-white" style="background-color: var(--u-turkuaz);">
                    <i class="bi bi-envelope-check-fill fs-1 d-block mb-2"></i>
                    <h4 class="fw-bold m-0">Bağlantı Gönderildi!</h4>
                </div>
                <div class="card-body p-5">
                    <p class="text-muted mb-4">
                        Şifre sıfırlama bağlantısı e-posta adresinize gönderildi. Lütfen gelen kutusunu (ve gereksiz kutusunu) kontrol ediniz.
                    </p>
                    <a asp-page="./Login" class="btn btn-lg text-white w-100 shadow-sm" style="background-color: var(--u-mavi); border-radius: 12px; font-weight: 600;">
                        Giriş Sayfasına Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
