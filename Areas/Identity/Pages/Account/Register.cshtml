@page
@model RegisterModel
@{
    ViewData["Title"] = "Öğrenci Kayıt Formu";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="m-0 fw-bold">MTÜ TURNUVA KAYIT SİSTEMİ</h4>
                </div>
                <div class="card-body p-4">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <h5 class="text-muted border-bottom pb-2 mb-4"><i class="bi bi-person-badge me-2"></i>Kişisel Bilgiler</h5>

                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.FirstName" class="form-control" placeholder="Ad" />
                                    <label asp-for="Input.FirstName">Ad</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.LastName" class="form-control" placeholder="Soyad" />
                                    <label asp-for="Input.LastName">Soyad</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.StudentNo" class="form-control" placeholder="Öğrenci No" />
                                    <label asp-for="Input.StudentNo">Öğrenci Numarası</label>
                                    <span asp-validation-for="Input.StudentNo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="05xx ..." />
                                    <label asp-for="Input.PhoneNumber">Telefon Numarası</label>
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <select asp-for="Input.Gender" class="form-select">
                                        <option value="">Seçiniz...</option>
                                        <option value="Erkek">Erkek</option>
                                        <option value="Kadın">Kadın</option>
                                    </select>
                                    <label asp-for="Input.Gender">Cinsiyet</label>
                                    <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <h5 class="text-muted border-bottom pb-2 my-4"><i class="bi bi-book me-2"></i>Akademik Bilgiler</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Faculty" class="form-control" placeholder="Fakülte" />
                                    <label asp-for="Input.Faculty">Fakülte</label>
                                    <span asp-validation-for="Input.Faculty" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Department" class="form-control" placeholder="Bölüm" />
                                    <label asp-for="Input.Department">Bölüm</label>
                                    <span asp-validation-for="Input.Department" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <h5 class="text-muted border-bottom pb-2 my-4"><i class="bi bi-shield-lock me-2"></i>Giriş Bilgileri</h5>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <label asp-for="Input.Email">E-Posta Adresi</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Şifre" />
                                    <label asp-for="Input.Password">Şifre</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Şifre Tekrar" />
                                    <label asp-for="Input.ConfirmPassword">Şifre Tekrar</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary mt-3 shadow-sm py-3 fw-bold">KAYIT OL VE ONAY BEKLE</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}