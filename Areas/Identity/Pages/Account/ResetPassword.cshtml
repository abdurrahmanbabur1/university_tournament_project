@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Şifre Sıfırlama";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                
                @* --- ÜST BAŞLIK ALANI --- *@
                <div class="p-4 text-center text-white" style="background-color: var(--u-mavi);">
                    <i class="bi bi-key-fill fs-1 d-block mb-2"></i>
                    <h4 class="fw-bold m-0">Yeni Şifre Belirle</h4>
                </div>

                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ad@ornek.com" style="border-radius: 12px; border: 1px solid #eee;" />
                            <label asp-for="Input.Email">E-posta Adresi</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre" style="border-radius: 12px; border: 1px solid #eee;" />
                            <label asp-for="Input.Password">Yeni Şifre</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre Tekrar" style="border-radius: 12px; border: 1px solid #eee;" />
                            <label asp-for="Input.ConfirmPassword">Yeni Şifre Tekrar</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg text-white shadow-sm" style="background-color: var(--u-turkuaz); border-radius: 12px; font-weight: 600; padding: 12px;">
                            <i class="bi bi-check-circle-fill me-2"></i> Şifreyi Sıfırla
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
