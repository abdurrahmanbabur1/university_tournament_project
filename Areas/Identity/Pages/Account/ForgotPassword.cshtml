@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                
                @* --- ÜST BAŞLIK ALANI --- *@
                <div class="p-4 text-center text-white" style="background-color: var(--u-mavi);">
                    <i class="bi bi-shield-lock-fill fs-1 d-block mb-2"></i>
                    <h4 class="fw-bold m-0">@ViewData["Title"]</h4>
                </div>

                <div class="card-body p-5">
                    <p class="text-muted text-center mb-4">
                        Şifrenizi sıfırlamak için kayıtlı e-posta adresinizi giriniz. Size bir sıfırlama bağlantısı göndereceğiz.
                    </p>

                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ad@ornek.com" style="border-radius: 12px; border: 1px solid #eee;" />
                            <label asp-for="Input.Email">E-posta Adresi</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg text-white shadow-sm mb-3" style="background-color: var(--u-turkuaz); border-radius: 12px; font-weight: 600; padding: 12px;">
                            <i class="bi bi-send-fill me-2"></i> Sıfırlama Bağlantısı Gönder
                        </button>

                        <div class="text-center">
                            <a asp-page="./Login" class="small fw-bold text-decoration-none" style="color: var(--u-mavi);">
                                <i class="bi bi-arrow-left me-1"></i> Giriş Sayfasına Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
